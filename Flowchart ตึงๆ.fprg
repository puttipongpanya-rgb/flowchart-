    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="Answer, Answer2, Answer3, Answer4, Answer5, Answer6" type="String" array="False" size=""/>
            <declare name="YES, NO, Knock, Talk, Test, NOPE" type="String" array="False" size=""/>
            <output expression="&quot;&#3588;&#3640;&#3603;&#3648;&#3604;&#3636;&#3609;&#3652;&#3611;&#3607;&#3637;&#3656;&#3610;&#3657;&#3634;&#3609; &#3586;&#3629;&#3591;&#3648;&#3614;&#3639;&#3656;&#3629;&#3609;&#3610;&#3657;&#3634;&#3609;&#3586;&#3629;&#3591;&#3588;&#3640;&#3603;!&quot;" newline="True"/>
            <output expression="&quot;&#3592;&#3632;&#3648;&#3604;&#3636;&#3609;&#3605;&#3656;&#3629;&#3652;&#3611;&#3652;&#3627;&#3617;?&quot;" newline="True"/>
            <output expression="&quot;YES or NO&quot;" newline="True"/>
            <input variable="Answer"/>
            <if expression="Answer == &quot;YES&quot;">
                <then>
                    <output expression="&quot;&#3605;&#3629;&#3609;&#3609;&#3637;&#3657;&#3588;&#3640;&#3603;&#3629;&#3618;&#3641;&#3656;&#3627;&#3609;&#3657;&#3634;&#3611;&#3619;&#3632;&#3605;&#3641;&#3649;&#3621;&#3657;&#3623;! ... &#3652;&#3591;&#3605;&#3656;&#3629;&#3604;&#3637;?&quot;" newline="True"/>
                    <output expression="&quot;Knock or Talk&quot;" newline="True"/>
                    <input variable="Answer3"/>
                    <if expression="Answer3 == &quot;Talk&quot;">
                        <then>
                            <output expression="&quot;&#3611;&#3621;&#3634; : &#3621;&#3641;&#3585;&#3629;&#3637;&#3649;&#3627;&#3617;&#3656;&#3617;&#3629;&#3618;&#3641;&#3656;&#3611;&#3656;&#3634;&#3623;!?&quot;" newline="True"/>
                            <output expression="&quot;...&quot;" newline="True"/>
                        </then>
                        <else>
                            <if expression="Answer3 == &quot;Knock&quot;">
                                <then/>
                                <else/>
                            </if>
                            <output expression="&quot;&#3588;&#3640;&#3603;&#3648;&#3588;&#3634;&#3632;&#3611;&#3619;&#3632;&#3605;&#3641;&#3604;&#3657;&#3623;&#3618;&#3588;&#3623;&#3634;&#3617;&#3626;&#3640;&#3616;&#3634;&#3614;... &#3612;&#3656;&#3634;&#3609;&#3585;&#3634;&#3619;&#3648;&#3605;&#3632;&#3611;&#3619;&#3632;&#3605;&#3641;&quot;" newline="True"/>
                            <output expression="&quot;&#3650;&#3629; here! &#3588;&#3640;&#3603;&#3648;&#3605;&#3632;&#3649;&#3619;&#3591;&#3652;&#3611; &#3611;&#3619;&#3632;&#3605;&#3641;&#3614;&#3633;&#3591;&#3648;&#3621;&#3618;! ....&#3651;&#3588;&#3619;&#3592;&#3656;&#3634;&#3618;?&quot;" newline="True"/>
                        </else>
                    </if>
                    <output expression="&quot;&#3611;&#3621;&#3634; : &#3652;&#3617;&#3656;&#3617;&#3637;&#3585;&#3634;&#3619;&#3605;&#3629;&#3610;&#3585;&#3621;&#3633;&#3610;&#3592;&#3634;&#3585;&#3648;&#3621;&#3586;- &#3585;&#3655; here &#3649;&#3621;&#3657;&#3623;!!!&quot;" newline="True"/>
                    <output expression="&quot;&#3611;&#3621;&#3634; : &#3652;&#3629;&#3648;&#3605;&#3657;&#3652;&#3617;&#3656;&#3629;&#3618;&#3641;&#3656;&#3627;&#3619;&#3629;..? NAH &#3609;&#3656;&#3634;&#3592;&#3632; &#3605;&#3638;&#3591;&#3648;&#3585;&#3617;&#3629;&#3618;&#3641;&#3656;&quot;" newline="True"/>
                    <output expression="&quot;&#3588;&#3640;&#3603;&#3648;&#3604;&#3636;&#3609;&#3648;&#3586;&#3657;&#3634;&#3652;&#3611;&#3651;&#3609;&#3610;&#3657;&#3634;&#3609;&#3629;&#3618;&#3641;&#3656;&#3604;&#3637; btw&quot;" newline="True"/>
                    <output expression="&quot;&#3588;&#3640;&#3603;&#3648;&#3627;&#3655;&#3609;&#3586;&#3629;&#3591;&#3648;&#3627;&#3621;&#3623;&#3626;&#3637;&#3649;&#3604;&#3591;&#3610;&#3609;&#3614;&#3639;&#3657;&#3609;... &#3607;&#3635;&#3652;&#3591;&#3604;&#3637;?&quot;" newline="True"/>
                    <output expression="&quot;Test or NOPE&quot;" newline="True"/>
                    <input variable="Answer4"/>
                    <if expression="Answer4 == &quot;Test&quot;">
                        <then>
                            <output expression="&quot;reroreroreroreororero&quot;" newline="True"/>
                            <output expression="&quot;...!!!&quot;" newline="True"/>
                            <output expression="&quot;&#3609;&#3637;&#3657;&#3617;&#3633;&#3609;&#3619;&#3626;&#3594;&#3634;&#3605;&#3636;&#3586;&#3629;&#3591;&#3588;&#3609;&#3650;&#3585;&#3627;&#3585;! &#3649;&#3621;&#3632;... &#3609;&#3657;&#3635;&#3649;&#3604;&#3591;&#3612;&#3626;&#3617;&#3618;&#3634;&#3648;&#3610;&#3639;&#3629;&#3627;&#3609;&#3641;! ... &#3648;&#3604;&#3637;&#3659;&#3618;&#3623;&#3609;&#3632;-&quot;" newline="True"/>
                            <output expression="&quot;ENDING 5 : &#3609;&#3633;&#3585;&#3626;&#3639;&#3610;&#3607;&#3637;&#3656;&#3604;&#3637;&#3605;&#3657;&#3629;&#3591; &#3648;&#3626;&#3614;- test &#3585;&#3656;&#3629;&#3609;&quot;" newline="True"/>
                        </then>
                        <else>
                            <if expression="Answer4 == &quot;NOPE&quot;">
                                <then/>
                                <else/>
                            </if>
                            <output expression="&quot;&#3588;&#3640;&#3603;&#3648;&#3604;&#3636;&#3609;&#3612;&#3656;&#3634;&#3609;&#3652;&#3611;&#3650;&#3604;&#3618; no &#3626;&#3609; no care&quot;" newline="True"/>
                            <output expression="&quot;...&quot;" newline="True"/>
                            <output expression="&quot;&#3588;&#3640;&#3603;&#3652;&#3604;&#3657;&#3618;&#3636;&#3609;&#3648;&#3626;&#3637;&#3618;&#3591;&#3617;&#3634;&#3592;&#3634;&#3585;&#3604;&#3657;&#3634;&#3609;&#3610;&#3609;!&quot;" newline="True"/>
                            <output expression="&quot;&#3588;&#3640;&#3603;&#3648;&#3604;&#3636;&#3609;&#3586;&#3638;&#3657;&#3609;&#3652;&#3611;&#3649;&#3621;&#3632;&#3652;&#3604;&#3657;&#3619;&#3641;&#3657;&#3623;&#3656;&#3634;&#3648;&#3626;&#3637;&#3618;&#3591;&#3617;&#3634;&#3592;&#3634;&#3585;&#3611;&#3619;&#3632;&#3605;&#3641;&#3610;&#3634;&#3591;&#3627;&#3609;&#3638;&#3656;&#3591;&quot;" newline="True"/>
                            <output expression="&quot;&#3648;&#3611;&#3636;&#3604;&#3627;&#3619;&#3639;&#3629;&#3652;&#3617;&#3656;&#3604;&#3637;?&quot;" newline="True"/>
                            <output expression="&quot;YES OR NO&quot;" newline="True"/>
                            <input variable="Answer5"/>
                            <if expression="Answer5 == &quot;YES&quot;">
                                <then>
                                    <output expression="&quot;&#3588;&#3640;&#3603;&#3648;&#3611;&#3636;&#3604;&#3611;&#3619;&#3632;&#3605;&#3641;&#3648;&#3586;&#3657;&#3634;&#3652;&#3611;... &#3649;&#3621;&#3632;&#3652;&#3604;&#3657;&#3648;&#3627;&#3655;&#3609;&#3651;&#3609;&#3626;&#3636;&#3656;&#3591;&#3607;&#3637;&#3656;&#3652;&#3617;&#3656;&#3588;&#3623;&#3619;...&quot;" newline="True"/>
                                    <output expression="&quot;&#3648;&#3605;&#3657; : &#3652;&#3629; sus &#3611;&#3621;&#3634; &#3617;&#3638;&#3591;&#3617;&#3634;&#3610;&#3657;&#3634;&#3609;&#3585;&#3641;&#3607;&#3635;&#3652;&#3617;&#3648;&#3609;&#3637;&#3657;&#3618;?&quot;" newline="True"/>
                                    <output expression="&quot;&#3611;&#3621;&#3634; : &#3585;&#3655;&#3629;&#3618;&#3641;&#3656;&#3609;&#3637;&#3657;&#3627;&#3623;&#3656;&#3634;... &#3649;&#3606;&#3617;&#3617;&#3637;&#3586;&#3629;&#3591;&#3604;&#3637;&#3652;&#3617;&#3656;&#3649;&#3610;&#3656;&#3591;&#3585;&#3633;&#3609;&#3648;&#3621;&#3618;..&quot;" newline="True"/>
                                    <output expression="&quot;&#3611;&#3621;&#3634; : &#3609;&#3633;&#3657;&#3609;&#3617;&#3633;&#3609;&#3649;&#3623;&#3656;&#3609; op-!&quot;" newline="True"/>
                                    <output expression="&quot;ENDING 3 : &#3648;&#3586;&#3657;&#3634;&#3652;&#3617;&#3656;&#3652;&#3604;&#3657;&#3592;&#3656;&#3634;&#3618;&quot;" newline="True"/>
                                </then>
                                <else>
                                    <if expression="Answer5 == &quot;NO&quot;">
                                        <then/>
                                        <else/>
                                    </if>
                                    <output expression="&quot;&#3588;&#3640;&#3603;&#3648;&#3621;&#3639;&#3629;&#3585;&#3607;&#3637;&#3656;&#3592;&#3632;&#3652;&#3617;&#3656;&#3648;&#3611;&#3636;&#3604;.. &#3649;&#3605;&#3656;&#3649;&#3629;&#3610;&#3615;&#3633;&#3591;&#3649;&#3607;&#3609;&quot;" newline="True"/>
                                    <output expression="&quot;...&quot;" newline="True"/>
                                    <output expression="&quot;&#3648;&#3605;&#3657; : &#3614;&#3637;&#3656;&#3592;&#3659;&#3634;! &#3652;&#3617;&#3656;&#3652;&#3627;&#3623;&#3649;&#3621;&#3657;&#3623;&#3623;&#3623;&#3623;&#3623; &#3629;&#3641;&#3618;&#3618;&#3618;&#3618;&#3618;&#3618;&#3618;&#3618;!&quot;" newline="True"/>
                                    <output expression="&quot;&#3604;&#3641;&#3648;&#3627;&#3617;&#3639;&#3629;&#3609;&#3648;&#3614;&#3639;&#3656;&#3629;&#3609;&#3648;&#3605;&#3657;&#3592;&#3632;&#3605;&#3585;&#3629;&#3618;&#3641;&#3656;&#3651;&#3609;&#3629;&#3633;&#3609;&#3605;&#3619;&#3634;&#3618;! &#3588;&#3640;&#3603;&#3592;&#3632;&#3648;&#3586;&#3657;&#3634;&#3652;&#3611;&#3594;&#3656;&#3623;&#3618;&#3652;&#3627;&#3617;?&quot;" newline="True"/>
                                    <output expression="&quot;YES or NO&quot;" newline="True"/>
                                    <input variable="Answer6"/>
                                    <if expression="Answer6 == &quot;YES&quot;">
                                        <then>
                                            <output expression="&quot;&#3588;&#3640;&#3603;&#3585;&#3635;&#3621;&#3633;&#3591;&#3592;&#3632;&#3614;&#3633;&#3591;&#3611;&#3619;&#3632;&#3605;&#3641;&#3648;&#3586;&#3657;&#3634;&#3652;&#3611;!&quot;" newline="True"/>
                                            <output expression="&quot;na-NANI!?&quot;" newline="True"/>
                                            <output expression="&quot;ENDING 0 : HE KNOW&quot;" newline="True"/>
                                        </then>
                                        <else>
                                            <if expression="Answer6 == &quot;NO&quot;">
                                                <then/>
                                                <else/>
                                            </if>
                                            <output expression="&quot;&#3621;&#3639;&#3617;&#3652;&#3611;&#3618;&#3633;&#3591;&#3617;&#3637; battlepass &#3607;&#3637;&#3656;&#3605;&#3657;&#3629;&#3591;&#3652;&#3611;&#3607;&#3635;...  &#3591;&#3633;&#3657;&#3609;&#3652;&#3611;&#3649;&#3627;&#3621;&#3632;&quot;" newline="True"/>
                                            <output expression="&quot;ENDING 1 : good ending?&quot;" newline="True"/>
                                        </else>
                                    </if>
                                </else>
                            </if>
                        </else>
                    </if>
                </then>
                <else>
                    <if expression="Answer == &quot;NO&quot;">
                        <then>
                            <output expression="&quot;&#3648;&#3604;&#3637;&#3659;&#3618;&#3623;&#3654;! &#3609;&#3637;&#3657;&#3609;&#3634;&#3618;&#3617;&#3634; speedrun &#3619;&#3638;&#3618;&#3633;&#3591;&#3652;&#3591;?&quot;" newline="True"/>
                        </then>
                        <else/>
                    </if>
                    <output expression="&quot;YES or sybau&quot;" newline="True"/>
                    <input variable="Answer2"/>
                    <output expression="&quot;BRUH...&quot;" newline="True"/>
                    <output expression="&quot;ENDING 2 : &#3592;&#3632;&#3648;&#3586;&#3657;&#3634;&#3652;&#3611;&#3651;&#3609;&#3610;&#3657;&#3634;&#3609;&#3619;&#3657;&#3634;&#3591;&#3648;&#3614;&#3639;&#3656;&#3629;&#3629;&#3632;&#3652;&#3619;!? &#3588;&#3636;&#3604;&#3626;&#3636;! &#3588;&#3636;&#3604;!&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
