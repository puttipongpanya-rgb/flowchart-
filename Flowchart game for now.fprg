    <function name="menu1" type="None" variable="">
        <parameters/>
        <body>
            <declare name="choice" type="Integer" array="False" size=""/>
            <output expression="&quot;=== My Visual Novel ===&quot;" newline="True"/>
            <output expression="&quot;1. Start&quot;" newline="True"/>
            <output expression="&quot;2. Leave&quot;" newline="True"/>
            <input variable="choice"/>
            <if expression="choice == 1">
                <then>
                    <call expression="showScene1()"/>
                </then>
                <else>
                    <output expression="&quot;&#3616;&#3634;&#3614;&quot;" newline="True"/>
                    <call expression="showERROR1()"/>
                </else>
            </if>
        </body>
    </function>
    <function name="showERROR1" type="None" variable="">
        <parameters/>
        <body>
            <output expression="&quot;&quot;" newline="True"/>
            <call expression="menu1()"/>
        </body>
    </function>
    <function name="showScene1" type="None" variable="">
        <parameters/>
        <body>
            <declare name="choice" type="Integer" array="False" size=""/>
            <output expression="&quot;=== DAY 1 ===&quot;" newline="True"/>
