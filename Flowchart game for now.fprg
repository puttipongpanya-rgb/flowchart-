            <output expression="&quot;2. Walk away&quot;" newline="True"/>
            <output expression="&quot;Choose: &quot;" newline="True"/>
            <input variable="choice"/>
            <if expression="choice == 1">
                <then>
                    <output expression="&quot;=== DAY 1 ===&quot;" newline="True"/>
                    <output expression="&quot;Maka: you must be a new one, right?&quot;" newline="True"/>
